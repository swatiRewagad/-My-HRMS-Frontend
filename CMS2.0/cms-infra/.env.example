MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_USER=cms_user
MYSQL_PASSWORD=change_me_user_password
REDIS_PASSWORD=

# Only used when running docker-compose.extras.yml alongside this file — your real external
# OCR service. cms-backend calls it server-to-server; cms-portal-frontend's own copy of this
# address is set separately at build time (see environment.docker-local.ts), since Angular
# can't read this .env file at runtime.
OCR_EXTERNAL_URL=
