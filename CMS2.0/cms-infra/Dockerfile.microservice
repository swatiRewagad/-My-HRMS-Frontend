ARG SERVICE_NAME

FROM eclipse-temurin:21-jdk-alpine AS build
ARG SERVICE_NAME
WORKDIR /app

# The root pom.xml declares 15+ reactor modules, so `mvn -pl ... -am` needs every declared
# module's pom.xml on disk to resolve the reactor even though only cms-common,
# cms-infrastructure, and SERVICE_NAME actually get compiled. Copy the whole (dockerignore-
# filtered) tree rather than hand-picking directories, since that list drifts as services
# are added — see the .dockerignore note this Dockerfile relies on.
COPY . .

# Build only the shared modules + target service
RUN apk add --no-cache maven \
    && mvn install -pl cms-common,cms-infrastructure -am -DskipTests -q \
    && mvn package -pl ${SERVICE_NAME} -am -DskipTests -q

FROM eclipse-temurin:21-jre-alpine
ARG SERVICE_NAME
# Each service sets its own server.servlet.context-path (e.g. /cms-rules) in application.yml,
# so a bare /actuator/health 404s for all of them except the ones mounted at "/". Pass the
# matching path per service from docker-compose's build args.
ARG CONTEXT_PATH=""
ENV CONTEXT_PATH=${CONTEXT_PATH}
WORKDIR /app
RUN addgroup -S cms && adduser -S cms -G cms
COPY --from=build /app/${SERVICE_NAME}/target/*.jar app.jar
USER cms

# 127.0.0.1, not localhost: busybox wget resolves localhost to ::1 first, and the JVM only
# binds the IPv4 socket, so "localhost" fails with connection refused even when the app is up.
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD wget -qO- http://127.0.0.1:${SERVER_PORT:-8080}${CONTEXT_PATH}/actuator/health || exit 1

ENTRYPOINT ["java", \
  "-XX:+UseG1GC", \
  "-XX:MaxGCPauseMillis=200", \
  "-XX:InitialRAMPercentage=50.0", \
  "-XX:MaxRAMPercentage=75.0", \
  "-Djava.security.egd=file:/dev/./urandom", \
  "-jar", "app.jar"]
