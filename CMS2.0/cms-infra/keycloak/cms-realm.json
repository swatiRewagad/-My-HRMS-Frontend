{
  "realm": "cms",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      { "name": "ADMIN", "description": "System administrator" },
      { "name": "DEO", "description": "CRPC Data Entry Operator" },
      { "name": "REVIEWER", "description": "CRPC draft reviewer/approver" },
      { "name": "CRPC_HEAD", "description": "CRPC Operations Head" },
      { "name": "RBIO_OFFICER", "description": "RBIO regional office officer" },
      { "name": "CEPC_ADMIN", "description": "CEPC Administrator" },
      { "name": "CEPC_DO", "description": "CEPC Dealing Officer" },
      { "name": "CEPC_REVIEWER", "description": "CEPC Reviewer" },
      { "name": "CEPC_INCHARGE", "description": "CEPC In-Charge" },
      { "name": "CEPC_CLOSING_AUTHORITY", "description": "CEPC Closing Authority" },
      { "name": "MAIL_INTAKE_ADMIN", "description": "cms-mail-intake admin endpoints — review/replay/force-link quarantined mail" },

      { "name": "DO", "description": "Bare-name duplicate of CEPC_DO — cms-portal-frontend's own role-check code (keycloak-auth.service.ts, staff-dashboard.component.ts) checks unprefixed CEPC role names while the backend's @CepcRoleGuard requires the CEPC_ prefix. This is a real mismatch in the application code, not a config choice — see the setup guide's known-issues note. Test users below carry both forms so testing isn't blocked by it." },
      { "name": "INCHARGE", "description": "Bare-name duplicate of CEPC_INCHARGE — see the DO role's description" },
      { "name": "CA", "description": "Bare-name duplicate of CEPC_CLOSING_AUTHORITY — see the DO role's description" },
      { "name": "CP", "description": "Bare-name duplicate of CEPC_CONTACT_PERSON — see the DO role's description" }
    ]
  },
  "clients": [
    {
      "clientId": "cms-frontend",
      "name": "cms-frontend",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost/*", "http://localhost:4200/*", "http://localhost:4300/*"],
      "webOrigins": ["http://localhost", "http://localhost:4200", "http://localhost:4300", "+"]
    },
    {
      "clientId": "admin-cli",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect"
    }
  ],
  "users": [
