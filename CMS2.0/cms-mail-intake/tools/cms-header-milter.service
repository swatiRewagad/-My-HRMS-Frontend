[Unit]
Description=CMS X-Original-Sender Header Milter
Documentation=See milter.py in this directory
After=network.target postfix.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/cms-mail-intake/milter.py --port 8899
Restart=always
RestartSec=5
User=postfix
Group=postfix

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cms-header-milter

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
