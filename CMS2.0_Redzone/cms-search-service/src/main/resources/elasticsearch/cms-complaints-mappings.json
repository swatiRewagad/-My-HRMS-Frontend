{
  "dynamic": "strict",
  "properties": {
    "complaintId": {
      "type": "keyword"
    },
    "complaintNumber": {
      "type": "keyword"
    },

    "detectedLanguage": {
      "type": "keyword"
    },

    "subject": {
      "type": "text",
      "analyzer": "cms_indic",
      "fields": {
        "keyword": {
          "type": "keyword",
          "ignore_above": 512,
          "normalizer": "cms_lowercase"
        },
        "en": {
          "type": "text",
          "analyzer": "english"
        },
        "hi": {
          "type": "text",
          "analyzer": "hindi"
        },
        "bn": {
          "type": "text",
          "analyzer": "bengali"
        },
        "ur": {
          "type": "text",
          "analyzer": "cms_urdu"
        }
      }
    },
    "description": {
      "type": "text",
      "analyzer": "cms_indic",
      "fields": {
        "en": {
          "type": "text",
          "analyzer": "english"
        },
        "hi": {
          "type": "text",
          "analyzer": "hindi"
        },
        "bn": {
          "type": "text",
          "analyzer": "bengali"
        },
        "ur": {
          "type": "text",
          "analyzer": "cms_urdu"
        }
      }
    },
    "advisoryText": {
      "type": "text",
      "analyzer": "cms_indic",
      "fields": {
        "en": {
          "type": "text",
          "analyzer": "english"
        },
        "hi": {
          "type": "text",
          "analyzer": "hindi"
        }
      }
    },
    "withdrawalReason": {
      "type": "text",
      "analyzer": "cms_indic",
      "fields": {
        "en": {
          "type": "text",
          "analyzer": "english"
        },
        "hi": {
          "type": "text",
          "analyzer": "hindi"
        }
      }
    },
    "schemeCoverageReason": {
      "type": "text",
      "analyzer": "cms_indic",
      "fields": {
        "en": {
          "type": "text",
          "analyzer": "english"
        },
        "hi": {
          "type": "text",
          "analyzer": "hindi"
        }
      }
    },
    "reopenJustification": {
      "type": "text",
      "analyzer": "cms_indic",
      "fields": {
        "en": {
          "type": "text",
          "analyzer": "english"
        },
        "hi": {
          "type": "text",
          "analyzer": "hindi"
        }
      }
    },

    "closureClause": {
      "type": "keyword",
      "fields": {
        "text": {
          "type": "text",
          "analyzer": "cms_indic"
        }
      }
    },
    "reopenReason": {
      "type": "keyword"
    },

    "categoryId": {
      "type": "keyword"
    },
    "entityCode": {
      "type": "keyword"
    },
    "department": {
      "type": "keyword"
    },
    "status": {
      "type": "keyword"
    },
    "workflowStage": {
      "type": "keyword"
    },
    "milestone": {
      "type": "keyword"
    },
    "rbioOfficeCode": {
      "type": "keyword"
    },
    "groundOfComplaintId": {
      "type": "keyword"
    },
    "compensationType": {
      "type": "keyword"
    },
    "maintainabilityDetermination": {
      "type": "keyword"
    },
    "priority": {
      "type": "keyword"
    },
    "assignedOfficer": {
      "type": "keyword"
    },
    "assignedRole": {
      "type": "keyword"
    },

    "awardAmount": {
      "type": "scaled_float",
      "scaling_factor": 100
    },

    "createdAt": {
      "type": "date",
      "format": "strict_date_optional_time||epoch_millis"
    },
    "updatedAt": {
      "type": "date",
      "format": "strict_date_optional_time||epoch_millis"
    },

    "timeline": {
      "type": "nested",
      "dynamic": "strict",
      "properties": {
        "action": {
          "type": "keyword"
        },
        "fromStatus": {
          "type": "keyword"
        },
        "toStatus": {
          "type": "keyword"
        },
        "performedByRole": {
          "type": "keyword"
        },
        "performedAt": {
          "type": "date",
          "format": "strict_date_optional_time||epoch_millis"
        },
        "remarks": {
          "type": "text",
          "analyzer": "cms_indic",
          "fields": {
            "en": {
              "type": "text",
              "analyzer": "english"
            },
            "hi": {
              "type": "text",
              "analyzer": "hindi"
            },
            "bn": {
              "type": "text",
              "analyzer": "bengali"
            },
            "ur": {
              "type": "text",
              "analyzer": "cms_urdu"
            }
          }
        }
      }
    },

    "appealOrders": {
      "type": "nested",
      "dynamic": "strict",
      "properties": {
        "appealNumber": {
          "type": "keyword"
        },
        "clauseCode": {
          "type": "keyword"
        },
        "outcome": {
          "type": "keyword"
        },
        "orderSummary": {
          "type": "text",
          "analyzer": "cms_indic",
          "fields": {
            "en": {
              "type": "text",
              "analyzer": "english"
            },
            "hi": {
              "type": "text",
              "analyzer": "hindi"
            }
          }
        },
        "ground": {
          "type": "text",
          "analyzer": "cms_indic",
          "fields": {
            "en": {
              "type": "text",
              "analyzer": "english"
            }
          }
        },
        "correctionReason": {
          "type": "text",
          "analyzer": "cms_indic",
          "fields": {
            "en": {
              "type": "text",
              "analyzer": "english"
            }
          }
        }
      }
    }
  }
}
